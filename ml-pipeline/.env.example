# ── App ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
API_SECRET_TOKEN=change-me-to-a-long-random-token
DEBUG=False
PORT=8000
CORS_ORIGINS=*

# ── Database (Render PostgreSQL or external) ───────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/farmersync

# ── Model Storage: Cloudflare R2 (S3-compatible) ──────────────────────────
S3_BUCKET=farmersync-models
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
AWS_REGION=auto

# ── Active model version (used when R2 is unreachable at startup) ──────────
MODEL_VERSION=v1

# ── Retraining thresholds ─────────────────────────────────────────────────
MIN_SAMPLES_TO_RETRAIN=100
MIN_ACCURACY_IMPROVEMENT=0.01

# ── Self-URL so train.py can call /api/model/reload after upload ───────────
ML_API_URL=https://your-app.onrender.com
