# ── App ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
API_SECRET_TOKEN=change-me-to-a-long-random-token
DEBUG=False
PORT=8000
CORS_ORIGINS=*

# ── Database (Render PostgreSQL — this is the ONLY storage you need) ───────
DATABASE_URL=postgresql://user:password@host:5432/farmersync

# ── Active model version (fallback label when DB has no model yet) ─────────
MODEL_VERSION=v1

# ── Retraining thresholds ─────────────────────────────────────────────────
MIN_SAMPLES_TO_RETRAIN=100
MIN_ACCURACY_IMPROVEMENT=0.01

# ── Self-URL so train.py can call /api/model/reload after retraining ───────
ML_API_URL=https://your-app.onrender.com
